<?xml version="1.0" encoding="UTF-8"?>
<parametersSet xmlns="http://www.rte-france.com/dynawo">
  <set id="IBUS">
    <par type="DOUBLE" name="infiniteBus_U0Pu" value="0.9"/>
    <par type="DOUBLE" name="infiniteBus_UPhase" value="0"/>
    <par type="DOUBLE" name="infiniteBus_UEvtPu" value="0.55"/>
    <par type="DOUBLE" name="infiniteBus_tUEvtStart" value="1.0"/>
    <par type="DOUBLE" name="infiniteBus_tUEvtEnd" value="99"/>
    <par type="DOUBLE" name="infiniteBus_omega0Pu" value="1.0"/>
    <par type="DOUBLE" name="infiniteBus_omegaEvtPu" value="1.0"/>
    <par type="DOUBLE" name="infiniteBus_tOmegaEvtStart" value="98"/>
    <par type="DOUBLE" name="infiniteBus_tOmegaEvtEnd" value="99"/>
  </set>
  <set id="B1">
    <par type="DOUBLE" name="bus_U0Pu" value="0.9"/>
    <par type="DOUBLE" name="bus_UPhase0" value="0"/>
  </set>
  <set id="LINE">
    <par type="DOUBLE" name="line_RPu" value="0.001"/>
    <par type="DOUBLE" name="line_XPu" value="0.01"/>
    <par type="DOUBLE" name="line_BPu" value="0"/>
    <par type="DOUBLE" name="line_GPu" value="0"/>
  </set>
  <set id="EL">
    <par type="DOUBLE" name="load_P0Pu" value="0.001"/>
    <par type="DOUBLE" name="load_Q0Pu" value="0"/>
    <par type="DOUBLE" name="load_U0Pu" value="0.2"/>
    <par type="DOUBLE" name="load_UPhase0" value="0"/>
    <par type="DOUBLE" name="load_Ud1Pu" value="0.7"/>
    <par type="DOUBLE" name="load_Ud2Pu" value="0.5"/>
    <par type="DOUBLE" name="load_recoveringShare" value="0.3"/>
    <par type="DOUBLE" name="load_tFilter" value="0.01"/>
  </set>
  <set id="FAULT">
    <par type="DOUBLE" name="fault_RPu" value="0.009"/>
    <par type="DOUBLE" name="fault_XPu" value="0"/>
    <par type="DOUBLE" name="fault_tBegin" value="1.0"/>
    <par type="DOUBLE" name="fault_tEnd" value="1.1"/>
  </set>
  <set id="IDA">
    <par type="INT" name="order" value="2"/>
    <par type="DOUBLE" name="initStep" value="1e-6"/>
    <par type="DOUBLE" name="minStep" value="1e-8"/>
    <par type="DOUBLE" name="maxStep" value="0.1"/>
    <par type="DOUBLE" name="absAccuracy" value="1e-7"/>
    <par type="DOUBLE" name="relAccuracy" value="1e-6"/>
    <par type="DOUBLE" name="fnormtolAlg" value="1e-10"/>
    <par type="DOUBLE" name="fnormtolAlgJ" value="1e-10"/>
    <par type="DOUBLE" name="fnormtolAlgInit" value="1e-10"/>
    <par type="STRING" name="minimumModeChangeTypeForAlgebraicRestoration" value="ALGEBRAIC_J_UPDATE"/>
  </set>
  <set id="SIM">
    <par type="DOUBLE" name="hMin" value="0.000001"/>
    <par type="DOUBLE" name="hMax" value="0.01"/>
    <par type="DOUBLE" name="kReduceStep" value="0.5"/>
    <par type="INT" name="maxNewtonTry" value="10"/>
    <par type="DOUBLE" name="minimalAcceptableStep" value="1e-8"/>
    <par type="STRING" name="minimumModeChangeTypeForAlgebraicRestoration" value="ALGEBRAIC_J_UPDATE"/>
  </set>
  <set id="EL_unit">
    <par type="DOUBLE" name="P0Pu" value="0.001"/>
    <par type="DOUBLE" name="Q0Pu" value="0"/>
    <par type="DOUBLE" name="U0Pu" value="0.9"/>
    <par type="DOUBLE" name="UPhase0" value="0"/>
    <par type="DOUBLE" name="Ud1Pu" value="0.7"/>
    <par type="DOUBLE" name="Ud2Pu" value="0.5"/>
    <par type="DOUBLE" name="recoveringShare" value="0.3"/>
    <par type="DOUBLE" name="tFilter" value="10"/>
    <par type="DOUBLE" name="UMin0Pu" value="0.5"/>
  </set>
</parametersSet>
